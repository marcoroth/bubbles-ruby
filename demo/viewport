TEXT

class ViewportDemo
  include Bubbletea::Model

  def initialize
    @viewport = Bubbles::Viewport.new(width: 70, height: 15)
    @viewport.content = CONTENT

    @title_style = Lipgloss::Style.new.bold(true).foreground("212")
    @info_style = Lipgloss::Style.new.foreground("241")
    @percent_style = Lipgloss::Style.new.foreground("99")
    @border_style = Lipgloss::Style.new.border(Lipgloss::ROUNDED_BORDER).border_foreground("62").width(72)
  end

  def init
    [self, nil]
  end

  def update(message)
    case message
    when Bubbletea::KeyMessage
      case message.to_s
      when "q", "ctrl+c", "esc"
        return [self, Bubbletea.quit]
      end
    end

    @viewport, command = @viewport.update(message)

    [self, command]
  end

  def view
    percent = (@viewport.scroll_percent * 100).round
    scroll_info = @percent_style.render("#{percent}%")

    position = if @viewport.at_top?
                 "Top"
               elsif @viewport.at_bottom?
                 "Bottom"
               else
                 "#{@viewport.y_offset + 1}/#{@viewport.total_line_count}"
               end

    lines = []

    lines << ""
    lines << @title_style.render("  Viewport Demo")
    lines << ""
    lines << @border_style.render(@viewport.view)
    lines << ""
    lines << @info_style.render("  #{position}  #{scroll_info}")
    lines << ""
    lines << @info_style.render("  ↑/↓/j/k scroll • PgUp/PgDn page • g/G top/bottom • q quit")
    lines << ""

    lines.join("\n")
  end
end

Bubbletea.run(ViewportDemo.new)
